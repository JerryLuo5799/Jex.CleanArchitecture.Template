<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Template package project. It produces a NuGet package of PackageType=Template that contains
    every template under templates/ (the solution template plus the item templates).
    It never compiles anything: all C# under templates/ is content.
  -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <!-- Version (not PackageVersion) so one -p:Version=X stamps this package and Jex.Cli alike. -->
    <Version>2.0.0</Version>
    <PackageId>Jex.CleanArchitecture.Template</PackageId>
    <Title>Jex Clean Architecture</Title>
    <Authors>JerryLuo</Authors>
    <Description>Opinionated Clean Architecture template for .NET 10: Minimal API endpoint groups, MediatR CQRS with pipeline behaviours, FluentValidation, FreeSql Code First with versioned migrations, JWT auth, unit/integration/architecture tests, Docker, optional .NET Aspire, and AGENTS.md for AI-assisted development. Includes jex-usecase / jex-endpoint / jex-entity item templates.</Description>
    <PackageTags>dotnet-new;templates;clean-architecture;cqrs;minimal-api;freesql;mediatr;fluentvalidation;jwt;aspire;ai-agents</PackageTags>
    <PackageProjectUrl>https://github.com/JerryLuo5799/Jex.CleanArchitecture.Template</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JerryLuo5799/Jex.CleanArchitecture.Template</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon Condition="Exists('docs/icon.png')">icon.png</PackageIcon>
    <!-- Dotfiles (.editorconfig, .gitignore, .template.config, .github, .claude) are template content. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>

    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates\**"
             Exclude="templates\**\bin\**;templates\**\obj\**;templates\**\.vs\**;templates\**\*.user;templates\**\logs\**;templates\**\*.db;templates\**\*.db-*;templates\**\TestResults\**;templates\**\artifacts\**;templates\solution\jex.json" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="docs\icon.png" Pack="true" PackagePath="\" Condition="Exists('docs\icon.png')" />
  </ItemGroup>

  <!--
    jex.json records the template version a project was generated with. The source file says 0.0.0-dev (what a
    directory install of ./templates produces); the packed copy is stamped with the package version at pack time,
    next to .template.config in the template root, without touching the source tree.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);StampJexManifest</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="StampJexManifest">
    <PropertyGroup>
      <_JexManifestSource>$(MSBuildThisFileDirectory)templates\solution\jex.json</_JexManifestSource>
      <_JexManifestStamped>$(IntermediateOutputPath)jex.json</_JexManifestStamped>
      <_JexManifestText>$([System.IO.File]::ReadAllText('$(_JexManifestSource)').Trim().Replace('"0.0.0-dev"', '"$(PackageVersion)"'))</_JexManifestText>
    </PropertyGroup>
    <Error Condition="!$(_JexManifestText.Contains('&quot;$(PackageVersion)&quot;'))" Text="Could not stamp $(PackageVersion) into $(_JexManifestSource)." />
    <WriteLinesToFile File="$(_JexManifestStamped)" Lines="$(_JexManifestText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_JexManifestStamped)" PackagePath="content/templates/solution/jex.json" />
    </ItemGroup>
  </Target>

</Project>
