{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=jex.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "AutoSyncStructure": false
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "Jex",
    "Audience": "Jex",
    "ExpiryMinutes": 60
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "internalLogLevel": "Warn",
    "internalLogFile": "${basedir}/logs/nlog-internal.txt",
    "extensions": [
      { "assembly": "NLog.Web.AspNetCore" }
    ],
    "variables": {
      "requestId": "${scopeproperty:item=TraceId:whenEmpty=${aspnet-TraceIdentifier}}"
    },
    "targets": {
      "console": {
        "type": "ColoredConsole",
        "layout": "${longdate}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${requestId}|${message}${onexception:inner=|${exception:format=tostring}}"
      },
      "app": {
        "type": "File",
        "fileName": "${basedir}/logs/${shortdate}-app.json",
        "archiveAboveSize": 5242880,
        "maxArchiveDays": 15,
        "layout": {
          "type": "JsonLayout",
          "includeEventProperties": true,
          "attributes": [
            { "name": "time", "layout": "${date:format=o}" },
            { "name": "level", "layout": "${level:uppercase=true}" },
            { "name": "logger", "layout": "${logger}" },
            { "name": "requestId", "layout": "${requestId}" },
            { "name": "message", "layout": "${message}" },
            { "name": "exception", "layout": "${exception:format=tostring}" }
          ]
        }
      },
      "sql": {
        "type": "File",
        "fileName": "${basedir}/logs/${shortdate}-sql.txt",
        "archiveAboveSize": 5242880,
        "maxArchiveDays": 15,
        "layout": "${longdate}|${requestId}|${message}"
      }
    },
    "rules": [
      { "logger": "Microsoft.*", "maxLevel": "Info", "final": true },
      { "logger": "System.*", "maxLevel": "Info", "final": true },
      { "logger": "FreeSql", "minLevel": "Debug", "writeTo": "sql", "final": true },
      { "logger": "*", "minLevel": "Info", "writeTo": "console,app" }
    ]
  }
}
