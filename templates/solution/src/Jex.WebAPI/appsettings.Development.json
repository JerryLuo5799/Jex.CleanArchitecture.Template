{
  "Database": {
    //#if (TemplateSourceOnly)
    "Provider": "Sqlite",
    //#endif
    "AutoSyncStructure": true
  },
  //#if (TemplateSourceOnly)
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=dev.db"
  },
  //#endif
  "Cors": {
    "AllowedOrigins": [ "*" ]
  },
  "Seed": {
    "Admin": {
      "Enabled": true,
      "Email": "admin@example.com",
      "Password": "Admin123!"
    }
  },
  "Jwt": {
    "Secret": "3c7b3c0a-6e3f-4d6d-9d2a-7f4e2b1c8a90b2a9f1d4-5c6e-4f7a-8b9c-0d1e2f3a4b5c"
  },
  "NLog": {
    "rules": [
      { "logger": "Microsoft.Hosting.Lifetime", "minLevel": "Info", "writeTo": "console", "final": true },
      { "logger": "Microsoft.*", "maxLevel": "Info", "final": true },
      { "logger": "System.*", "maxLevel": "Info", "final": true },
      { "logger": "FreeSql", "minLevel": "Debug", "writeTo": "sql,console", "final": true },
      { "logger": "*", "minLevel": "Debug", "writeTo": "console,app" }
    ]
  }
}
