{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Jex.WebAPI (Development)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Jex.WebAPI/bin/Debug/net10.0/Jex.WebAPI.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Jex.WebAPI",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5208"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/scalar"
      }
    }
  ]
}
