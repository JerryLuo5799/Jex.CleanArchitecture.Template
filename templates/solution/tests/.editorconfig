# Test projects: relax rules that conflict with the {Method}_{Scenario}_{Expected} naming
# convention and with idiomatic test code. Everything else inherits from the solution .editorconfig.
[*.cs]
dotnet_diagnostic.CA1707.severity = none   # Identifiers should not contain underscores
dotnet_diagnostic.CA1515.severity = none   # Make types internal (test classes must be public)
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage delegates
dotnet_diagnostic.CA1062.severity = none   # Validate arguments of public methods
dotnet_diagnostic.CA1031.severity = none   # Do not catch general exception types
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait
dotnet_diagnostic.CA1861.severity = none   # Constant arrays as arguments
dotnet_diagnostic.CA1812.severity = none   # Uninstantiated internal classes (fixtures)
dotnet_diagnostic.CA2234.severity = none   # Pass Uri instead of string (HttpClient in tests)
dotnet_diagnostic.CA1054.severity = none   # URI parameters should not be strings
dotnet_diagnostic.CA1056.severity = none   # URI properties should not be strings
dotnet_diagnostic.CA1001.severity = none   # Types owning disposables (xunit manages lifetime)
dotnet_diagnostic.CA1063.severity = none   # Implement IDisposable correctly
dotnet_diagnostic.CA1816.severity = none   # GC.SuppressFinalize
dotnet_diagnostic.xUnit1051.severity = none # TestContext cancellation token: not needed for short HTTP calls
dotnet_diagnostic.CA1873.severity = none   # Logging argument evaluation (mock verifications)
