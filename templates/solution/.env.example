# Copy to .env (git-ignored) before `docker compose --profile api ... up`.
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
# Required when running the API container: at least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=
# Apply pending migrations on container start (single instance only; otherwise run `task db:migrate` from the pipeline).
MIGRATION_RUN_ON_STARTUP=false
CORS_ALLOWED_ORIGIN=*
#if (UsePostgreSQL)
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
#endif
#if (UseSqlServer)
MSSQL_SA_PASSWORD=Your_password123
MSSQL_PORT=1433
#endif
#if (UseMySql)
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
#endif
